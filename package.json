{
  "name": "trellis-dashboard",
  "version": "0.1.0",
  "description": "A local, read-only dashboard for Trellis projects",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=18.18" },
  "bin": { "trellis-dashboard": "bin/trellis-dashboard.mjs" },
  "files": ["bin/", "dist/", "README.md", "LICENSE"],
  "keywords": [
    "trellis",
    "dashboard",
    "project-panel",
    "spec-driven-development",
    "read-only",
    "cli",
    "local"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/007sair/trellis-dashboard.git"
  },
  "homepage": "https://github.com/007sair/trellis-dashboard#readme",
  "bugs": { "url": "https://github.com/007sair/trellis-dashboard/issues" },
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node bin/trellis-dashboard.mjs",
    "dev": "npm run build && node bin/trellis-dashboard.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:unit",
    "test:unit": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run typecheck && npm test && npm run test:e2e && npm run test:package",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "unified": "^11.0.5",
    "vite": "^6.3.5"
  }
}
